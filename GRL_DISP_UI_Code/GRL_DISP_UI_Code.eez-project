                                  "text_color": "#0b0000",
                                  "text_font": "MONTSERRAT_16",
                                  "text_line_space": 2,
                                  "pad_left": 10
                                }
                              }
                            }
                          },
                          "group": "",
                          "groupIndex": 0,
                          "text": "The GRL USB Power Delivery (PD) Dual Role Power (DRP) & Data Loop Back Tester (V-DPWR-EPR) is an advanced and versatile testing solution designed to help engineers meet the most demanding test requirements for USB Type-C and USB Power Delivery (USB PD) hosts and devices. Featuring a high-performance test port capable of both sourcing and loading up to 240W through a single USB-C connection, it incorporates intelligent thermal airflow management to enable continuous, reliable testing over extended durations making it the ideal choice for Regression Testing and development of next-generation USB PD products.",
                          "textType": "literal",
                          "longMode": "WRAP",
                          "recolor": false
                        },
                        {
                          "objID": "886eee22-6013-4535-e818-ef311eac343d",
